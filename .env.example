# =============================================================================
# status-pilot — variáveis de ambiente (copie para .env.local e preencha)
# .env.local NÃO vai para o git. Este arquivo é só documentação.
# =============================================================================

# --- Supabase (SOMENTE backend: API routes e scripts) ------------------------
# service_role key NUNCA pode ir para o frontend.
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...            # service_role (secreta)
SUPABASE_DB_URL=postgres://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres  # conexão direta p/ scripts de schema

# --- Jira Basic auth (email + API token) -------------------------------------
# Usado por scripts (tsx) e lib/sync.ts. Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://SEUNOME.atlassian.net       # sem barra no final
JIRA_EMAIL=voce@empresa.com
JIRA_API_TOKEN=seu-api-token
JIRA_PROJECT_KEY_SCRUM=LS                          # chave do projeto Scrum
JIRA_PROJECT_KEY_KANBAN=LK                         # chave do projeto Kanban

# --- Jira OAuth 2.0 (3LO) ----------------------------------------------------
# Crie o app 3LO em https://developer.atlassian.com/console/myapps
#   • adicione os scopes: read:jira-work read:jira-user offline_access
#   • callback (Authorization callback URL): http://localhost:3000/api/jira/callback
JIRA_OAUTH_CLIENT_ID=seu-client-id
JIRA_OAUTH_CLIENT_SECRET=seu-client-secret
JIRA_OAUTH_REDIRECT_URI=http://localhost:3000/api/jira/callback
